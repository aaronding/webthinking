{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webthinking",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker redirects www and passes the demos through
    "run_worker_first": true
  }
}
